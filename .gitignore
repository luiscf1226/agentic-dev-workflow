# Generated workflow artifacts (root only — a bare name matches at ANY depth,
# which silently swallowed templates/phases.md; keep these anchored with a leading slash)
/problem.md
/problem.graph.mmd
/spec.md
/phases.md
/design-tokens.json

# Project map is generated per-consuming-repo, not committed here
/.agentic/

# OS / editor cruft
.DS_Store
*.swp

# Harness skill dirs are generated by ./setup.sh — symlinks to skills/, or copies
# on platforms without symlink support. Never committed: committing a symlink breaks
# Windows copy-mode users, and committing copies would triple every skill in the repo.
.claude/skills
.cursor/skills
.codex/skills
